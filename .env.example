# Clerk authentication (optional — the app falls back to a local demo session when unset)
# Values come from the Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Frozen XGBoost inference service. Deploy backend/ as a container and set this
# to its HTTPS URL. The web app does not generate substitute predictions.
ML_SERVICE_URL=
ML_SERVICE_AUTH_TOKEN=

# Google OAuth — required for Google Fit integration
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the "Fitness API" at https://console.cloud.google.com/apis/library/fitness.googleapis.com
# Authorised redirect URI must match: https://<your-domain>/api/google-fit/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-fit/callback

# AI Calling System & Telephony
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_PHONE_NUMBER=
EXOTEL_BASE_URL=https://api.exotel.com
VOICE_SERVER_PORT=5050
NEXT_PUBLIC_VOICE_SERVER_WS_URL=ws://localhost:5050

# Google Places API (New) — Emergency Assistance Nearby Healthcare Directory
# Enable "Places API (New)" in Google Cloud Console: https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

